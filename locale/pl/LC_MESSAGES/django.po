#: devices/models.py:17
msgid ""
"Lowercase letters and digits, words separated by single hyphens, e.g. plug-"
"living-room."
msgstr ""
"Małe litery i cyfry, słowa oddzielone pojedynczym łącznikiem, np. gniazdko-"
"salon."

#: devices/models.py:24
msgid "Lowercase letters, digits and underscores, e.g. shelly."
msgstr "Małe litery, cyfry i podkreślenia, np. shelly."

#: devices/models.py:46 devices/models.py:105
msgid "Parameters must be a JSON object."
msgstr "Parametry muszą być obiektem JSON."

#: devices/models.py:50
#, python-format
msgid ""
"Parameters look like a secret: %(keys)s. Passwords do not belong in the "
"device config."
msgstr ""
"Parametry wyglądają na sekret: %(keys)s. Hasła nie należą do konfiguracji "
"urządzenia."

#: devices/models.py:70
msgid ""
"Device identifier in MQTT topics (home/&lt;slug&gt;/…). Cannot be changed "
"later."
msgstr ""
"Identyfikator urządzenia w tematach MQTT (home/&lt;slug&gt;/…). Nie można go "
"później zmienić."

#: devices/models.py:75
msgid "Device family handled by the gateway: shelly, tasmota, w1."
msgstr "Rodzina urządzeń obsługiwana przez gateway: shelly, tasmota, w1."

#: devices/models.py:79
msgid ""
"Driver parameters, e.g. shelly: {\"prefix\": \"shelly/plug1\", "
"\"component\": \"switch:0\"}; tasmota: {\"topic\": \"nous1\"}; w1: "
"{\"sensor\": \"28-00000a99077c\", \"interval_s\": 60}."
msgstr ""
"Parametry sterownika, np. shelly: {\"prefix\": \"shelly/plug1\", "
"\"component\": \"switch:0\"}; tasmota: {\"topic\": \"nous1\"}; w1: "
"{\"sensor\": \"28-00000a99077c\", \"interval_s\": 60}."

#: devices/models.py:108
msgid "The slug cannot be changed – create a new device instead."
msgstr "Sluga nie można zmienić – dodaj nowe urządzenie."

#: devices/models.py:112
msgid ""
"The kind cannot be changed while the device has rules – delete its rules "
"first."
msgstr ""
"Nie można zmienić rodzaju urządzenia, które ma reguły – najpierw usuń jego "
"reguły."

#: devices/models.py:171
msgid "Days must be a non-empty list of distinct numbers 0–6 (0 = Monday)."
msgstr "Dni muszą być niepustą listą różnych liczb 0–6 (0 = poniedziałek)."

#: devices/models.py:185
msgid "Days of the week, 0 = Monday … 6 = Sunday, e.g. [0, 1, 2, 3, 4]."
msgstr "Dni tygodnia, 0 = poniedziałek … 6 = niedziela, np. [0, 1, 2, 3, 4]."

#: devices/models.py:187
msgid "Local time."
msgstr "Czas lokalny."

#: devices/models.py:189
msgid ""
"Fields of a set command for the device kind, e.g. switch {\"on\": true}; "
"light {\"on\": true, \"brightness\": 30, \"mode\": \"cct\", \"ct\": 2700}."
msgstr ""
"Pola polecenia set dla rodzaju urządzenia, np. przełącznik {\"on\": true}; "
"światło {\"on\": true, \"brightness\": 30, \"mode\": \"cct\", \"ct\": 2700}."

