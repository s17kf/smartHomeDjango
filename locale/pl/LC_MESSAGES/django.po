#: devices/models.py:16
msgid ""
"Lowercase letters and digits, words separated by single hyphens, e.g. plug-"
"living-room."
msgstr ""
"Małe litery i cyfry, słowa oddzielone pojedynczym łącznikiem, np. gniazdko-"
"salon."

#: devices/models.py:23
msgid "Lowercase letters, digits and underscores, e.g. shelly."
msgstr "Małe litery, cyfry i podkreślenia, np. shelly."

#: devices/models.py:45 devices/models.py:101
msgid "Parameters must be a JSON object."
msgstr "Parametry muszą być obiektem JSON."

#: devices/models.py:49
#, python-format
msgid ""
"Parameters look like a secret: %(keys)s. Passwords do not belong in the "
"device config."
msgstr ""
"Parametry wyglądają na sekret: %(keys)s. Hasła nie należą do konfiguracji "
"urządzenia."

#: devices/models.py:69
msgid ""
"Device identifier in MQTT topics (home/&lt;slug&gt;/…). Cannot be changed "
"later."
msgstr ""
"Identyfikator urządzenia w tematach MQTT (home/&lt;slug&gt;/…). Nie można go "
"później zmienić."

#: devices/models.py:74
msgid "Device family handled by the gateway: shelly, tasmota, w1."
msgstr "Rodzina urządzeń obsługiwana przez gateway: shelly, tasmota, w1."

#: devices/models.py:78
msgid ""
"Driver parameters, e.g. shelly: {\"prefix\": \"shelly/plug1\", "
"\"component\": \"switch:0\"}; tasmota: {\"topic\": \"nous1\"}; w1: "
"{\"sensor\": \"28-00000a99077c\", \"interval_s\": 60}."
msgstr ""
"Parametry sterownika, np. shelly: {\"prefix\": \"shelly/plug1\", "
"\"component\": \"switch:0\"}; tasmota: {\"topic\": \"nous1\"}; w1: "
"{\"sensor\": \"28-00000a99077c\", \"interval_s\": 60}."

#: devices/models.py:104
msgid "The slug cannot be changed – create a new device instead."
msgstr "Sluga nie można zmienić – dodaj nowe urządzenie."

