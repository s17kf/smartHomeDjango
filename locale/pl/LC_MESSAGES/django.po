#: devices/admin.py:48
#, python-format
msgid ""
"The device was saved, but its config did not reach the MQTT broker: "
"%(error)s. Run \"manage.py mqtt_sync\" when the broker is available."
msgstr "Urządzenie zapisane, ale jego konfiguracja nie dotarła do brokera MQTT: %(error)s. Uruchom „manage.py mqtt_sync”, gdy broker będzie dostępny."

#: devices/admin.py:54
#, python-format
msgid ""
"The device was deleted, but the MQTT broker still has its topics: %(error)s. "
"Run \"manage.py mqtt_sync --prune\" when the broker is available."
msgstr "Urządzenie usunięte, ale jego tematy zostały w brokerze MQTT: %(error)s. Uruchom „manage.py mqtt_sync --prune”, gdy broker będzie dostępny."

#: devices/kinds.py:29
